# Infrastructure supplied by docker-compose
DATABASE_URL=postgresql+asyncpg://medassist:medassist_dev_password@localhost:5432/medassist
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medical_knowledge
# The corpus is downloaded from this URL only when the indexing command is run.
MEDICAL_DATASET_PATH=medical_rag_dataset.json
MEDICAL_DATASET_URL=https://drive.google.com/uc?id=1JrCN_UG_4bJht6NbzQe3_a3ytqi3dXAG

# Firebase Cloud Admin credentials. Set one of these before running the API.
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Jina AI
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSIONS=1024

# Groq through Portkey
PORTKEY_API_KEY=
# Saved Portkey fallback config containing the primary and secondary Groq virtual keys.
PORTKEY_CONFIG_ID=pc-xxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Optional observability
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=medassist-api
NEMO_GUARDRAILS_ENABLED=true

# Gmail SMTP reminder delivery worker (use a Google App Password, not your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourgmail@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM="MedAssist AI <yourgmail@gmail.com>"
SMTP_REPLY_TO=yourgmail@gmail.com
REMINDER_WORKER_BATCH_SIZE=50
REMINDER_MAX_ATTEMPTS=5
REMINDER_CLAIM_TIMEOUT_MINUTES=10
# Generate a long random secret. Configure the same value as an EasyCron request header.
REMINDER_WORKER_TRIGGER_TOKEN=

# Comma-separated frontend origins
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080
